# Public URL of the site (used for SEO, sitemap and Stripe redirects)
NEXT_PUBLIC_SITE_URL=https://www.example.co.uk

# Stripe — create the account in the business owner's name: https://dashboard.stripe.com
# Without this key the site still takes bookings with "pay the driver".
STRIPE_SECRET_KEY=sk_live_xxx

# Booking notifications by email via Resend (https://resend.com). Optional.
RESEND_API_KEY=re_xxx
BOOKING_NOTIFY_EMAIL=bookings@example.co.uk
BOOKING_FROM_EMAIL=Bookings <bookings@example.co.uk>
